---
interface Props {
  html: string;
  fallbackHref: string;
  fallbackLabel: string;
}

const { html, fallbackHref, fallbackLabel } = Astro.props;
---

<div class="tweet-embed" data-tweet-embed>
  <div class="tweet-embed__frame" set:html={html} />
  <p class="tweet-embed__fallback">
    Embed not loading?
    <a href={fallbackHref} target="_blank" rel="noreferrer">{fallbackLabel}</a>
  </p>
</div>

<script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
<script is:inline>
  (function () {
    function loadWidgets() {
      var twttr = window.twttr;
      var root = document.querySelector("[data-tweet-embed]");
      if (twttr && twttr.widgets && twttr.widgets.load && root) {
        twttr.widgets.load(root);
      }
    }

    var attempts = 0;
    var timer = window.setInterval(function () {
      attempts += 1;
      if (window.twttr && window.twttr.widgets) {
        loadWidgets();
        window.clearInterval(timer);
      } else if (attempts > 40) {
        window.clearInterval(timer);
      }
    }, 100);
  })();
</script>
