{
  "name": "whatships.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Product Launch Videos — a curated directory of product launch videos from X/Twitter.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "posters:capture": "node scripts/capture-posters.mjs",
    "discovery": "node scripts/discovery/run.mjs",
    "discovery:dry-run": "node scripts/discovery/run.mjs --dry-run",
    "discovery:fixture": "node scripts/discovery/run.mjs --dry-run --lookback-days=30 --fixture=scripts/discovery/fixtures/sample-posts.json",
    "discovery:seed-inbox": "node scripts/discovery/run.mjs --dry-run --write-inbox --lookback-days=30 --fixture=scripts/discovery/fixtures/sample-posts.json",
    "inbox:apply": "node scripts/apply-inbox.mjs",
    "inbox:apply:dry-run": "node scripts/apply-inbox.mjs --dry-run",
    "deploy": "astro build && rm -rf dist/streams && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.116.0"
  },
  "packageManager": "pnpm@11.13.1"
}
