# Copy to .env and fill in (never commit .env)

# Preferred for discovery: App-Only Bearer Token from
# Developer Portal → your App → Keys and tokens → Bearer Token
# (must have READ access on a paid/read-capable plan)
X_BEARER_TOKEN=

# OAuth 2.0 Client ID / Secret (portal “User authentication settings”)
# These alone are NOT enough for timeline reads — use with Bearer above,
# or exchange Consumer API Key+Secret via oauth2/token for app-only access.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Soft password for /admin (hashed into the client bundle at build time)
ADMIN_PASSWORD=

# Optional email digest (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=
DISCOVERY_FROM_EMAIL=
